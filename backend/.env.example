# Media Library Backend Configuration

# Server Port
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# Media Directory Path
MEDIA_DIR=./media

# Thumbnail Directory Path
THUMB_DIR=./thumbnails

# Database File Path
DB_FILE=media.db

# ===== Large Media Library Settings =====

# Skip auto-scan on startup for faster boot (recommended for large libraries)
# Set to "false" to disable auto-scan, then trigger manually via POST /scan
# Defaults to true
AUTO_SCAN_ON_STARTUP=false

# Number of files to process in each batch during scanning
# Lower = less memory usage, slower | Higher = more memory usage, faster
# Defaults to 50
SCAN_BATCH_SIZE=50

# Delay in milliseconds between processing each batch
# Useful to reduce CPU/memory load on slow systems
# 0 = no delay (fastest) | 100-500 = gentle on system resources
# Defaults to 0
SCAN_DELAY_MS=0

# ===== Example Configurations =====
# Small library (< 1000 files): AUTO_SCAN_ON_STARTUP=true, BATCH_SIZE=100
# Medium library (1000-10000): AUTO_SCAN_ON_STARTUP=true, BATCH_SIZE=50
# Large library (10000-50000): AUTO_SCAN_ON_STARTUP=false, BATCH_SIZE=50, DELAY=100
# Huge library (50000+): AUTO_SCAN_ON_STARTUP=false, BATCH_SIZE=25, DELAY=200

